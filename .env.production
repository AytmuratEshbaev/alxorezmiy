# Build vaqtida klient kodiga joylanadigan OMMAVIY sozlamalar (secret EMAS).
# Secret'lar (RESEND_API_KEY, ADMIN_EMAIL, TURNSTILE_SECRET_KEY) bu yerga yozilmaydi —
# ular Cloudflare dashboard yoki `npx wrangler secret put` orqali qo'shiladi.

NEXT_PUBLIC_SITE_URL=https://alxorezmiy.uz

# Cloudflare Turnstile → widget yaratganingizda beriladigan "Site Key".
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 1 — rasmlar /cdn-cgi/image/ orqali o'lchamlanadi (zonada Images → Transformations yoqilgan bo'lishi shart).
# 0 — o'chirilgan (masalan, faqat *.workers.dev'da sinayotganda).
NEXT_PUBLIC_IMAGE_RESIZING=1

# Ixtiyoriy: R2 bucket'ga custom domain ulasangiz (masalan https://media.alxorezmiy.uz).
# Bo'sh qolsa rasmlar Worker'ning /media/ yo'li orqali beriladi.
NEXT_PUBLIC_MEDIA_URL=
